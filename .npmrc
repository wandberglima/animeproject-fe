# A Cloudflare Pages roda npm com NODE_ENV=production, e com isso o npm ignora as devDependencies.
# O Angular CLI e o @angular/build sao devDependencies, entao o ng nao era instalado e o build
# falhava antes de gerar qualquer pasta. Confirmado em teste: com NODE_ENV=production o devDep nao e
# instalado; sem a variavel, e.
#
# include=dev mantem o ng disponivel sem.NODE_ENV precisar ser alterado.
include=dev
